# Copy to .env (never commit .env). Only VASTAI_KEY and HF_TOKEN are required; everything
# else is optional and shown here with its default.

# --- Credentials (required) ---
VASTAI_KEY=
HF_TOKEN=
# account  = store HF_TOKEN as a Vast account environment variable (default, keeps it out of the template)
# template = embed it in the template's env
# HF_TOKEN_MODE=account

# --- Names ---
# NAME_PREFIX=llamacpp
# TEMPLATE_NAME=llamacpp-template
# ENDPOINT_NAME=llamacpp-endpoint

# --- PyWorker ---
# Public Git URL of this repo. If unset, derived from this repo's `origin` remote.
# PYWORKER_REPO=https://github.com/<you>/<this-repo>
# PYWORKER_REF=main
# Override only if Vast changes its bootstrap script:
# PYWORKER_BOOTSTRAP_CMD=curl -L https://raw.githubusercontent.com/vast-ai/pyworker/main/start_server.sh | bash

# --- Machine ---
# IMAGE=nvidia/cuda:12.8.1-devel-ubuntu22.04
# DISK_GB=200
# SEARCH_PARAMS=direct_port_count>=2 compute_cap>=1200 cuda_max_good>=12.8 gpu_ram>=90000 gpu_total_ram>=90000 cpu_ram>=64000 num_gpus=1 disk_space>=200

# --- Model (defaults = Qwen3.8-Flash-Next IQ3_S with vision; override for another GGUF model) ---
# MODEL_REPO=ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF
# MODEL_PATTERNS=IQ3_S/*,mmproj-Qwen3.8-Flash-Next-BF16.gguf
# MODEL_FILE=IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf
# MMPROJ_FILE=mmproj-Qwen3.8-Flash-Next-BF16.gguf   # empty or "none" for text-only models
# EXTRA_ARGS="-lm mmap --lazy-mode on"             # empty or "none" if the model needs none
# KV_TYPE=q8_0
# SLOTS=5
# CTX_PER_SLOT=262144
# MODEL_NAME=default

# --- Endpoint / workergroup scaling ---
# MIN_LOAD=10
# TARGET_UTIL=0.9
# COLD_MULT=2.0
# COLD_WORKERS=1
# MAX_WORKERS=2
# TEST_WORKERS=1    # each test worker rents a GPU while benchmarking; the CLI default is 3
# GPU_RAM=80        # estimated GPU RAM (GiB) the model needs
